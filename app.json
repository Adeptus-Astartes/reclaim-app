{
  "expo": {
    "name": "Reclaim",
    "slug": "reclaim-app",
    "scheme": "reclaim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/graphics/logo_v1.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.reclaim.mobile"
    },
    "android": {
      "package": "app.reclaim.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/graphics/logo_v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/graphics/logo_v1.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
